diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..b9616995372236eee6bc5ad26164ff5bbd8b02e7
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,14 @@
+'use strict';
+// Bound all public AST walkers, including caller-supplied/cyclic ASTs.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  const seen = new WeakSet();
+  let count = 0;
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > 100 || ++count > 100000 || seen.has(node)) throw new SyntaxError('Brace AST exceeds safe depth/size or contains a cycle');
+    seen.add(node);
+    if (Array.isArray(node.nodes)) for (const child of node.nodes) pending.push([child, depth + 1]);
+  }
+};
