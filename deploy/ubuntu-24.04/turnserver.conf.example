# Public relay template. Never substitute the permissive loopback test fixture.
listening-port=3478
tls-listening-port=5349
realm=turn.example.com
server-name=turn.example.com
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_API
cert=/etc/turnserver/tls/fullchain.pem
pkey=/etc/turnserver/tls/privkey.pem
min-port=49160
max-port=49259
max-allocate-lifetime=300
stale-nonce=600
user-quota=4
total-quota=100
max-bps=1000000
bps-capacity=10000000
no-cli
no-multicast-peers
no-tcp-relay
no-tlsv1
no-tlsv1_1
no-dtls
# Never enable verbose logging or allow-loopback-peers. No passwords in logs.
log-file=/dev/null
no-stdout-log
# listening-ip=THE_LOCAL_INTERFACE_ADDRESS
# relay-ip=THE_LOCAL_INTERFACE_ADDRESS
# For a 1:1 NAT VPS only: external-ip=PUBLIC_IP/LOCAL_IP
# Prevent this public relay from reaching private, loopback, reserved and metadata peers.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::
denied-peer-ip=::1
# Block IPv4-mapped IPv6 paths as well as native private IPv4.
denied-peer-ip=::ffff:0:0-::ffff:ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fec0::-feff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=ff00::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
