NODE_ENV=production
HOST=127.0.0.1
PORT=8080
PUBLIC_API_ORIGIN=https://api.example.com
CORS_ORIGINS=https://api.example.com
ALLOW_REGISTRATION=false
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_CLUSTER.mongodb.net/browserproxy?retryWrites=true&w=majority&tls=true
ACCOUNT_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
BROWSER_ENGINE_ENABLED=true
BROWSER_PROFILE_ROOT=/var/lib/browser-proxy/profiles
BROWSER_MAX_ACTIVE=3
CHROMIUM_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
# Direct fallback is forbidden. Configure approved per-account proxies and proxy-routed DoH.
BROWSER_ALLOW_DIRECT=false
WEBRTC_STUN_URLS=stun:turn.example.com:3478
WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
WEBRTC_TURN_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_COTURN
