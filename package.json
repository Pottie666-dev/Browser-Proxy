{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./apps/**\" --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "mobile:prebuild": "pnpm --filter @workspace/browser-app exec expo prebuild --platform android",
    "mobile:android:native": "pnpm --filter @workspace/browser-app exec expo run:android",
    "mobile:doctor": "pnpm --filter @workspace/browser-app run doctor",
    "mobile:typecheck": "pnpm run typecheck:libs && pnpm --filter @workspace/browser-app run typecheck",
    "api:typecheck": "pnpm run typecheck:libs && pnpm --filter @workspace/api-server run typecheck",
    "doctor:browser-proxy": "node scripts/browser-proxy-doctor.mjs",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "test": "pnpm --filter @workspace/api-server run test && node --test scripts/test/*.test.mjs",
    "db:migrate": "pnpm --filter @workspace/api-server run db:migrate",
    "test:browser:confined": "pnpm --filter @workspace/api-server run test:browser:confined",
    "companion:build": "cd apps/android-companion && ./gradlew :app:assembleDebug",
    "companion:test": "cd apps/android-companion && ./gradlew :app:testDebugUnitTest :app:lintDebug",
    "api:release": "bash scripts/build-api-release.sh",
    "api:deployment:check": "node apps/api/tools/deployment-check.mjs",
    "android:development": "bash scripts/build-android-development.sh"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19.0"
  }
}
