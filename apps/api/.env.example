# Supply real values securely. Never commit a filled .env file.
MONGODB_URI=
# Exactly 32 random bytes, encoded as base64 or 64 hex characters. Keep backups.
ACCOUNT_ENCRYPTION_KEY=
PUBLIC_API_ORIGIN=https://api.example.invalid
CORS_ORIGINS=https://controller.example.invalid
# Enable only for explicit user onboarding, then disable.
ALLOW_REGISTRATION=false
PORT=3000
HOST=0.0.0.0

# Isolated browser worker: Linux Chromium + bubblewrap namespaces + working Chromium sandbox.
# Leave disabled until the host is configured and its confinement tests pass.
BROWSER_ENGINE_ENABLED=false
BROWSER_PROFILE_ROOT=/var/lib/browser-proxy/profiles
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
BROWSER_MAX_ACTIVE=3
BROWSER_ALLOW_DIRECT=false
# Explicit operator-owned private upstream gateways only, comma-separated host:port.
BROWSER_TRUSTED_PROXY_AUTHORITIES=
# Destination DNS is sent through the same account proxy; no host-DNS fallback.
BROWSER_DOH_ENDPOINT=https://cloudflare-dns.com/dns-query
BROWSER_DOH_BOOTSTRAP_IP=1.1.1.1
# Set a trusted verifier returning a plain IP or JSON {"ip":"..."}.
BROWSER_IP_CHECK_URL=
